# 1. IF STATEMENT

age = 20

if age >= 18:
    print("You are an adult")


# 2. IF-ELSE STATEMENT

age = int(input("Enter your age: "))

if age >= 18:
    print("You are an adult")
else:
    print("You are a minor")


# 3. ELIF STATEMENT - Marks Checker

marks = int(input("Enter your marks: "))

if marks >= 90:
    print("Excellent")
elif marks >= 75:
    print("Good")
elif marks >= 50:
    print("Pass")
else:
    print("Fail")


# 4. COMPARISON OPERATORS

age = 20

print(age > 18)
print(age < 18)
print(age >= 20)
print(age <= 20)
print(age == 20)
print(age != 20)


# 5. LOGICAL OPERATORS - AND

age = 20
has_id = True

print(age >= 18 and has_id)


# 6. LOGICAL OPERATORS - OR

is_student = False
has_discount = True

print(is_student or has_discount)


# 7. LOGICAL OPERATORS - NOT

is_running = True

print(not is_running)


