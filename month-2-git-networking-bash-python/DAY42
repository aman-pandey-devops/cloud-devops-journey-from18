# 9. SERVER ACCESS CHECK - AND / OR

age = int(input("Enter age: "))
has_id = input("Do you have ID? (yes/no): ")
is_admin = input("Are you an admin? (yes/no): ")

if age >= 18 and has_id == "yes":
    print("Access Granted")
elif is_admin == "yes":
    print("Access Granted as Admin")
else:
    print("Access Denied")


# 10. NESTED IF

age = int(input("Enter age: "))

if age >= 18:
    has_id = input("Do you have ID? (yes/no): ")

    if has_id == "yes":
        print("You can enter")
    else:
        print("ID required")
else:
    print("You are underage")


