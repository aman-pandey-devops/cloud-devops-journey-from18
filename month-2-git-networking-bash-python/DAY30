#ATM Menu

choice = int(input("Enter Choice: "))

match choice:
    case 1:
        print("Check Balance")
    case 2:
        print("Deposit Money")
    case 3:
        print("Withdraw Money")
    case 4:
        print("Exit")
    case _:
        print("Invalid Choice")



#Calculator

num1 = int(input("First Number: "))
num2 = int(input("Second Number: "))
operator = input("Operator (+,-,*,/): ")

match operator:
    case "+":
        print(num1 + num2)
    case "-":
        print(num1 - num2)
    case "*":
        print(num1 * num2)
    case "/":
        if num2 != 0:
            print(num1 / num2)
        else:
            print("Cannot divide by zero")
    case _:
        print("Invalid Operator")
