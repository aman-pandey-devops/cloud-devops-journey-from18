                                                                         Loop + Conditions



# Loop + Conditions Hands-on Practice


# 1. For loop

for i in range(5):
    print(i)


# 2. Range()

for i in range(1, 6):
    print(i)


for i in range(2, 11, 2):
    print(i)


for i in range(10, 4, -1):
    print(i)


# 3. While loop

count = 1

while count <= 5:
    print(count)
    count = count + 1


# 4. While loop with user input

count = 1
limit = int(input("Enter limit: "))

while count <= limit:
    print(count)
    count = count + 1


# 5. Break

for i in range(1, 11):
    print(i)

    if i == 5:
        break


# 6. Continue

for i in range(1, 11):

    if i == 5:
        continue

    print(i)


# 7. Loop + If - Even numbers

for i in range(1, 11):

    if i % 2 == 0:
        print(i)


# 8. Loop + If - Odd numbers

for i in range(1, 11):

    if i % 2 != 0:
        print(i)


# 9. DevOps-style example - CPU monitoring

for cpu in range(50, 101, 10):

    print("CPU usage:", cpu)

    if cpu > 80:
        print("WARNING: High CPU usage!")


# 10. Mini Hands-on Challenge - Server Health Checker

for cpu in range(50, 101, 10):

    print("CPU:", cpu)

    if cpu <= 80:
        print("CPU Normal")
    else:
        print("WARNING: High CPU")
