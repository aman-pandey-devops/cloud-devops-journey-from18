# 7. DevOps Hands-on
# Check logs directory and list files


import os

folder = "logs"

if os.path.exists(folder):
    print("Logs folder exists")

    files = os.listdir(folder)

    print("Files inside logs:")

    for file in files:
        print(file)

else:
    print("Logs folder does not exist")
